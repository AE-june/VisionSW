{
  "name": "visionsw-ui",
  "version": "0.1.3",
  "description": "VisionSW Node-based Inspection Tool",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.smartray.visionsw",
    "productName": "VisionSW",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/bin/Release/VisionEngine.exe",
        "to": "VisionEngine.exe"
      },
      {
        "from": "../build/bin/Release/opencv_world4110.dll",
        "to": "opencv_world4110.dll"
      },
      {
        "from": "../build/bin/Release/fmt.dll",
        "to": "fmt.dll"
      },
      {
        "from": "../build/bin/Release/spdlog.dll",
        "to": "spdlog.dll"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@xyflow/react": "^12.11.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "ws": "^8.21.0"
  }
}
